# Copy this file to ".env" and fill in your key.
# REQUIRED — without this the chatbot cannot call the AI model.
# Get a free key (no card) at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_REAL_KEY_HERE

# Optional: model order (comma-separated, tried in turn). Leave unset to use
# the built-in default (openrouter/free + fallbacks).
# OPENROUTER_MODEL=openrouter/free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free

# Optional: your deployed URL (used only in OpenRouter attribution headers).
# APP_URL=https://darglobal-wasalt-chatbot-9ob3.onrender.com
